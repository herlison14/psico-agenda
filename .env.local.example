# ============================================================
# PsiPlanner — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local com valores reais.
# ============================================================

# ------------------------------------------------------------
# NextAuth / Autenticação
# ------------------------------------------------------------
# Gere AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=gere-com-openssl-rand-base64-32
# NEXTAUTH_SECRET é alias para AUTH_SECRET (NextAuth v4 compat)
# NEXTAUTH_SECRET=

# URL pública da aplicação (sem barra no final)
NEXTAUTH_URL=http://localhost:3000
# AUTH_URL é alias preferido pelo NextAuth v5 — use um dos dois
# AUTH_URL=http://localhost:3000

# ------------------------------------------------------------
# Banco de Dados — Railway PostgreSQL
# Acesse: Railway → seu projeto → PostgreSQL → Connect
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/railway

# Opcional: "strict" para validar certificado TLS (produção)
# DATABASE_SSL=strict

# ------------------------------------------------------------
# IA — Anthropic Claude
# Console: https://console.anthropic.com/settings/keys
# Usado em: demo chat, prontuário SOAP (transcrição)
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Transcrição de Áudio — Groq Whisper
# Console: https://console.groq.com/keys
# Usado em: /api/sessoes/[id]/transcrever
# ------------------------------------------------------------
GROQ_API_KEY=gsk_...

# ------------------------------------------------------------
# Pagamentos — Asaas PIX
# Dashboard: https://app.asaas.com (produção)
#            https://sandbox.asaas.com (sandbox)
# ------------------------------------------------------------
ASAAS_API_KEY=$aact_...
ASAAS_API_BASE=https://api.asaas.com/v3
# Em sandbox use: https://sandbox.asaas.com/api/v3

# Token para validar webhooks (Asaas → seu endpoint)
# Configure em: Asaas → Integrações → Webhooks → Token
ASAAS_WEBHOOK_TOKEN=seu-token-webhook-asaas

# ------------------------------------------------------------
# E-mail — SMTP (Nodemailer)
# Exemplos: smtp.gmail.com:587, smtp.resend.com:465
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-gmail
EMAIL_FROM=noreply@psiplanner.com.br

# ------------------------------------------------------------
# Segurança — Painel Admin
# Gere com: openssl rand -base64 32
# ------------------------------------------------------------
ADMIN_MASTER_KEY=gere-com-openssl-rand-base64-32

# E-mail que recebe notificações internas do sistema (opcional)
# ADMIN_EMAIL=admin@psiplanner.com.br

# ------------------------------------------------------------
# Agente IA — July (Python FastAPI no Render)
# Compartilhado com o serviço Python em /agente/.env
# Gere com: openssl rand -base64 32
# ------------------------------------------------------------
AGENTE_API_KEY=gere-com-openssl-rand-base64-32

# UUID do psicólogo padrão para instâncias single-tenant do agente
# PSICOLOGO_ID=00000000-0000-0000-0000-000000000000
